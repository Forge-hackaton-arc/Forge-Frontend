# Base URL of the Forge-Backend Next.js app (see that repo's README, runs on :4000 by default)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase project — same project the backend writes to.
# IMPORTANT: the backend only ever uses the service-role key server-side. For the
# frontend's realtime subscriptions (jobs/reputation/payments) to work, the
# Supabase project needs SELECT granted to the `anon` role on those three tables
# (either via an RLS policy or by leaving RLS disabled on them). That's a Supabase
# dashboard config step, not something this app can do on its own — see README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Arc Testnet block explorer, used to build links for every tx hash / contract address shown.
NEXT_PUBLIC_ARC_EXPLORER_BASE_URL=https://testnet.arcscan.app

# When true (or when live fetches fail), the UI clearly labels itself as running
# on fixture data instead of silently showing fake numbers as if they were live.
# Defaults to true until real backend + Supabase credentials are wired in.
NEXT_PUBLIC_USE_MOCKS=true
